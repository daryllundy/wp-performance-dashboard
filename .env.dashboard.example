# Copy this file to .env and choose one data source:
# 1. Direct database access with DB_* variables
# 2. External WordPress API with WP_API_* variables

# Server
PORT=3000
CORS_ORIGINS=http://localhost:3000
ADMIN_TOKEN=replace-with-a-long-random-token

# Direct database mode
DB_HOST=localhost
DB_PORT=3306
DB_USER=dashboard_user
DB_PASSWORD=replace-with-db-password
DB_NAME=wordpress_performance

# External WordPress API mode
# WP_API_URL=https://your-wordpress-site.com
# WP_API_USERNAME=your-api-username
# WP_API_PASSWORD=your-api-password

# Optional demo settings
# DEMO_MODE=true
# DEMO_DB_HOST=demo-mysql
# DEMO_DB_PORT=3306
# DEMO_DB_USER=demo_user
# DEMO_DB_PASSWORD=demo_password
# DEMO_DB_NAME=demo_wordpress

# Optional debugging
# DEBUG_MONITORING=true
